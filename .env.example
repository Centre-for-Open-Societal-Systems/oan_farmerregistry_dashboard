# Copy to .env.local for `npm run dev`; in a container, set these as env vars.

# Where chart rows come from: the registry's dashboard-api (cluster-internal).
CHART_SOURCE=http
DASHBOARD_API_URL=http://localhost:8005
# Chart rows are served for this long before a background refresh (min 60).
DASHBOARD_CACHE_TTL_SECONDS=900
# How this server authenticates to the dashboard-api: none, or
# client-credentials (a Keycloak token of DASHBOARD_CLIENT_ID on every chart
# request; the dashboard-api checks it when its AUTH_ISSUER is set).
DASHBOARD_API_AUTH=none
# client-credentials only. Token endpoint; empty: that of the realm IAM signs
# staff in with. Its realm URL is the dashboard-api's AUTH_ISSUER.
OIDC_TOKEN_URL=
DASHBOARD_CLIENT_SECRET=

# Public origin of this dashboard: login return URLs are built from it, and a
# request for any other host is redirected here (the session cookies are only
# sent to hosts under COOKIE_DOMAIN). For `npm run dev`, set the dev port.
PUBLIC_URL=http://dashboard.farmer.localtest.me:3101

# The registry's IAM. Only this server calls it (login start, session, logout).
IAM_URL=http://iam.farmer.localtest.me:8100
# IAM login provider. Empty: discovered (the one whose callback lies under COOKIE_DOMAIN).
LOGIN_PROVIDER_ID=
# Keycloak client (= IAM application mnemonic) and the role that grants access.
DASHBOARD_CLIENT_ID=farmer-registry-dashboard
DASHBOARD_ROLE=Dashboard Viewer
# Domain IAM scopes its session cookies to (logout clears them there).
COOKIE_DOMAIN=farmer.localtest.me
# Ends the Keycloak session when IAM cannot (expired session). Optional.
OIDC_LOGOUT_URL=http://keycloak.localtest.me:8080/realms/farmer/protocol/openid-connect/logout
OIDC_CLIENT_ID=iam-staff-portal
# Seconds a validated session is trusted before IAM is asked again.
SESSION_CACHE_SECONDS=60
# Local UI work only. Never disable in a deployment.
AUTH_ENABLED=true

# Header links (optional).
STAFF_PORTAL_URL=http://staff.farmer.localtest.me:3102
REGISTRY_PORTAL_URL=http://portal.farmer.localtest.me:3100
